# Project-Clot Environment Configuration

# (Optional) Telegram Bot Notifications for price drops and restocks
# 1. Create a bot with @BotFather on Telegram to get your TOKEN
# 2. Get your numeric Chat ID with @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Optional) Discord Webhook Notification
DISCORD_WEBHOOK_URL=

# (Optional) 4910.kr liked-item member prices
# Value of the `ably-jwt-token` cookie while logged in to 4910.kr (DevTools -> Application -> Cookies).
# ABLY_JWT_TOKEN=
